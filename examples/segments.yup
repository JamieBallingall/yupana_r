yup 0.2

// Revenue by segment for an invented retailer. The segments are read from segments.csv beside
// this file, so their number is known when the workbook is written; the horizon is decided in
// the workbook.

workbook : Workbook
workbook = { sheets = [inputs, revenue_sheet] }

inputs : Sheet
inputs = { name = 'Inputs' }

revenue_sheet : Sheet
revenue_sheet = { name = 'Revenue' }

label : Style Cell
label = { format = '@' }

heading : Style Cell
heading = label { font = { bold = True } }

money : Style Cell
money = { format = '#,##0' }

percent : Style Cell
percent = { format = '0.0%' }

total : Style Cell
total = money { font = { bold = True }, border = { top = { weight = Thin } } }

// Inputs

horizon_label : Label style label at inputs $B$2
horizon_label = "Forecast horizon (years)"

horizon : Value Number horizon_label right 2
horizon = 6

segment_header : Label style heading horizon_label down 2
segment_header = "Segment"

base_header : Label style heading segment_header right
base_header = "Revenue in the base year"

growth_header : Label style heading base_header right
growth_header = "Growth per year"

segments : Value segment_header down
segments = csv "segments.csv"

// Revenue

year_label : Label style label at revenue_sheet $B$2
year_label = "Year"

year : Formula Number year_label right 2
year = 1 .. horizon

// A formula of text: the segments' names, one to a row, beside their revenue.
names : Formula Text style label year_label down
names = column "segment" segments

// One row per segment, one column per year: a column of segments times a row of years gives a
// grid.
revenue : Formula Number style money names right 2
revenue = column "base" segments * (1 + column "growth" segments) ^ year

// The rows above have a fixed height, so these rows can go below them.
total_label : Label style heading names down 2
total_label = "Total revenue"

total_revenue : Formula Number style total total_label right 2
total_revenue = sum_columns revenue

total_growth_label : Label style label total_label down
total_growth_label = "Growth in total revenue"

total_growth : Formula Number style percent total_revenue down 1 right 1 from west
total_growth = tail total_revenue / lag 1 total_revenue - 1
